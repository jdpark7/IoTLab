def action_create(cfg, req, r):
    u = validate_username(req.get("username"))
    password = validate_password(req.get("password"))
    components = validate_components(req.get("components", list(ALL_COMPONENTS)))
    node_port = validate_port(req.get("node_port"), cfg["node_port_range"], "node_port")
    spring_port = validate_port(req.get("spring_port"), cfg["spring_port_range"], "spring_port")
    force_change = bool(req.get("force_password_change", False))

    step_group(cfg, r)
    step_linux_user(cfg, r, u, password, force_change)    # 실패 시 중단 (예외)

    optional = [
        ("directories", lambda: step_dirs(cfg, r, u, components, node_port, spring_port)),
    ]
    if "nodejs" in components:
        optional.append(("nodered_settings", lambda: step_nodered(cfg, r, u, password, node_port)))
    optional += [
        ("supervisor_conf", lambda: step_supervisor(cfg, r, u, components, node_port, spring_port)),
        ("sudoers", lambda: step_sudoers(cfg, r, u, components)),
        ("nginx_conf", lambda: step_nginx(cfg, r, u, components, node_port, spring_port,
                                          test=not req.get("defer_reload"))),
    ]
    if "mqtt" in components:
        optional.append(("mqtt", lambda: step_mqtt(cfg, r, u, password)))
    else:
        optional.append(("mqtt_acl", lambda: acl_update(cfg, u, False)))
    if "mariadb" in components:
        optional.append(("mariadb", lambda: step_mariadb(cfg, r, u, password)))

    for name, fn in optional:
        try:
            fn()
        except (ProvisionError, OSError, subprocess.SubprocessError) as e:
            r.step(name, False, str(e))

    if not req.get("defer_reload"):
        do_reload(cfg, r, mosquitto="mqtt" in components)
    r.data.update({"username": u, "node_port": node_port, "spring_port": spring_port,
                   "components": components})


def action_password(cfg, req, r):
    """Linux / Node-RED / MQTT / MariaDB 비밀번호를 한꺼번에 바꾼다."""
    u = validate_username(req.get("username"))
    password = validate_password(req.get("password"))
    components = validate_components(req.get("components", list(ALL_COMPONENTS)))
    assert_managed(cfg, u)
    run([cfg["bin"]["chpasswd"]], input_text=f"{u}:{password}\n")
    r.step("linux_password", True)
    steps = []
    if "nodejs" in components:
        node_port = validate_port(req.get("node_port"), cfg["node_port_range"], "node_port")
        steps.append(("nodered_settings", lambda: step_nodered(cfg, r, u, password, node_port)))
    if "mqtt" in components:
        steps.append(("mqtt", lambda: step_mqtt(cfg, r, u, password)))
    if "mariadb" in components:
        steps.append(("mariadb", lambda: step_mariadb(cfg, r, u, password)))
    for name, fn in steps:
        try:
            fn()
        except (ProvisionError, OSError, subprocess.SubprocessError) as e:
            r.step(name, False, str(e))
    if "mqtt" in components:
        do_reload(cfg, r, nginx=False, supervisor=False, mosquitto=True)
    if "nodejs" in components:
        # 새 비밀번호 반영을 위해 실행 중이면 재시작
        proc = run([cfg["bin"]["supervisorctl"], "status", f"nodejs_{u}"], check=False)
        if "RUNNING" in (proc.stdout or ""):
            run([cfg["bin"]["supervisorctl"], "restart", f"nodejs_{u}"], check=False)


def action_service(cfg, req, r):
    u = validate_username(req.get("username"))
    svc = req.get("service")
    op = req.get("op")
    if svc not in SERVICES:
        raise ProvisionError(f"알 수 없는 service: {svc!r}")
    if op not in SERVICE_OPS:
        raise ProvisionError(f"알 수 없는 op: {op!r}")
    assert_managed(cfg, u)
    proc = run([cfg["bin"]["supervisorctl"], op, f"{svc}_{u}"], check=False, timeout=60)
    out = (proc.stdout or proc.stderr or "").strip()
    # supervisorctl status 는 정지 상태면 rc=3 을 돌려준다 → 오류 아님
    ok = proc.returncode == 0 or (op == "status" and proc.returncode == 3)
    if "ERROR" in out or "no such" in out.lower():
        ok = False
    r.step(f"{op} {svc}", ok, out)
    r.data["output"] = out


def parse_status(out):
    # "nodejs_a10029   RUNNING   pid 123, uptime 0:01:02"
    parts = out.split(None, 2)
    if len(parts) >= 2 and parts[1].isupper():
        return {"state": parts[1], "info": parts[2] if len(parts) > 2 else ""}
    return {"state": "UNKNOWN", "info": out}


def action_status(cfg, req, r):
    u = validate_username(req.get("username"))
    assert_managed(cfg, u)
    services = {}
    for svc in SERVICES:
        if not os.path.isfile(P(f"{cfg['supervisor_conf_dir']}/{svc}_{u}.conf")):
            continue
        proc = run([cfg["bin"]["supervisorctl"], "status", f"{svc}_{u}"], check=False)
        services[svc] = parse_status((proc.stdout or "").strip()) if not DRY_RUN \
            else {"state": "STOPPED", "info": "dry-run"}
    r.data["services"] = services
    r.step("status", True)


def strip_legacy_sudoers(cfg, u):
    """기존 공용 파일 /etc/sudoers.d/students-supervisor 에서 해당 학생 줄만 제거."""
    path = cfg["legacy_sudoers_file"]
    real = P(path)
    if not os.path.isfile(real):
        return False
    lines = open(real, encoding="utf-8").read().splitlines()
    kept = [l for l in lines if not re.match(rf"^{re.escape(u)}\s", l)]
    if len(kept) == len(lines):
        return False
    shutil.copy2(real, real + ".bak")
    install_sudoers(cfg, path, "\n".join(kept) + "\n")
    return True


def action_remove(cfg, req, r):
    u = validate_username(req.get("username"))
    purge = bool(req.get("purge", False))
    pw = assert_managed(cfg, u, allow_missing=True)
    b = cfg["bin"]

    def attempt(name, fn):
        try:
            detail = fn()
            r.step(name, True, detail or "")
        except (ProvisionError, OSError, subprocess.SubprocessError) as e:
            r.step(name, False, str(e))

    def stop_services():
        for svc in SERVICES:
            run([b["supervisorctl"], "stop", f"{svc}_{u}"], check=False)

    def rm_supervisor():
        gone = [svc for svc in SERVICES
                if remove_file(f"{cfg['supervisor_conf_dir']}/{svc}_{u}.conf")]
        return ", ".join(gone)

    def rm_sudoers():
        a = remove_file(f"{cfg['sudoers_dir']}/belajarhub-{u}")
        b_ = strip_legacy_sudoers(cfg, u)
        return f"own={a}, legacy={b_}"

    def rm_nginx():
        return str(remove_file(f"{cfg['nginx_conf_dir']}/{u}.conf"))

    def rm_mqtt():
        if os.path.isfile(P(cfg["mosquitto_passwd"])):
            run([b["mosquitto_passwd"], "-D", P(cfg["mosquitto_passwd"]), u], check=False)
        acl_update(cfg, u, False)

    attempt("stop_services", stop_services)
    attempt("supervisor_conf", rm_supervisor)
    attempt("sudoers", rm_sudoers)
    attempt("nginx_conf", rm_nginx)
    attempt("mqtt", rm_mqtt)

    if purge:
        def rm_db():
            run([b["mariadb"], "-u", "root"], input_text=(
                f"DROP DATABASE IF EXISTS `{u}`;\n"
                f"DROP USER IF EXISTS {sql_str(u)}@'localhost';\nFLUSH PRIVILEGES;\n"))

        def rm_dirs():
            return ", ".join(s for s in SRV_DIRS if safe_rmtree(f"{cfg['srv_base']}/{s}", u))

        def rm_user():
            if pw is not None or DRY_RUN:
                run([b["userdel"], "-r", u], check=False)

        attempt("mariadb_drop", rm_db)
        attempt("srv_dirs", rm_dirs)
        attempt("linux_user", rm_user)

    if not req.get("defer_reload"):
        do_reload(cfg, r)


def action_reload(cfg, req, r):
    do_reload(cfg, r)


ACTIONS = {
    "create": action_create,
    "password": action_password,
    "service": action_service,
    "status": action_status,
    "remove": action_remove,
    "reload": action_reload,
}


def main():
    if not DRY_RUN and os.geteuid() != 0:
        print(json.dumps({"ok": False, "error": "root 권한이 필요합니다"}))
        return 2
    r = Result()
    try:
        raw = sys.stdin.read(65536)
        req = json.loads(raw)
        if not isinstance(req, dict):
            raise ProvisionError("요청은 JSON 객체여야 합니다")
        action = ACTIONS.get(req.get("action"))
        if action is None:
            raise ProvisionError(f"알 수 없는 action: {req.get('action')!r}")
        cfg = load_config()
        os.umask(0o022)
        lock_path = P(cfg["lock_file"])
        os.makedirs(os.path.dirname(lock_path), exist_ok=True)
        with open(lock_path, "w") as lock:
            # 동시 실행 직렬화 (ACL/passwd 파일 경합 방지)
            fcntl.flock(lock, fcntl.LOCK_EX)
            action(cfg, req, r)
    except (ProvisionError, json.JSONDecodeError, OSError, subprocess.SubprocessError) as e:
        r.ok = False
        out = r.as_dict()
        out["error"] = str(e)
        print(json.dumps(out, ensure_ascii=False))
        return 1
    print(json.dumps(r.as_dict(), ensure_ascii=False))
    return 0 if r.ok else 1


if __name__ == "__main__":
    sys.exit(main())
