# 기존 계정 중 M20017 처럼 대문자가 섞인 것도 있어 대소문자 모두 허용한다.
USERNAME_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_-]{1,31}$")
RESERVED = {
    "root", "admin", "administrator", "www-data", "nobody", "daemon", "bin",
    "sys", "sync", "mail", "mysql", "mariadb", "mosquitto", "nginx", "postgres",
    "supervisor", "belajarhub", "portal", "mqtt", "www", "api", "ubuntu",
    "debian", "sudo", "staff", "students",
}

SANDBOX = os.environ.get("BELAJARHUB_SANDBOX", "")
DRY_RUN = bool(SANDBOX)


class ProvisionError(Exception):
    pass


def load_config():
    cfg = json.loads(json.dumps(DEFAULTS))
    path = P(CONFIG_FILE)
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as f:
            override = json.load(f)
        bins = override.pop("bin", {})
        cfg.update(override)
        cfg["bin"].update(bins)
    return cfg


def P(path):
    """샌드박스 모드에서는 절대경로를 샌드박스 아래로 옮긴다."""
    if SANDBOX:
        return os.path.join(SANDBOX, path.lstrip("/"))
    return path


# ---------------------------------------------------------------------------
# 결과 기록
# ---------------------------------------------------------------------------
class Result:
    def __init__(self):
        self.steps = []
        self.data = {}
        self.ok = True

    def step(self, name, ok=True, detail=""):
        self.steps.append({"step": name, "ok": ok, "detail": detail.strip()[-2000:]})
        if not ok:
            self.ok = False

    def as_dict(self):
        return {"ok": self.ok, "steps": self.steps, "data": self.data}


def run(cmd, input_text=None, check=True, timeout=120):
    """외부 명령 실행. 셸을 거치지 않는다."""
    if DRY_RUN:
        log = P("/commands.log")
        os.makedirs(os.path.dirname(log), exist_ok=True)
        with open(log, "a", encoding="utf-8") as f:
            f.write(" ".join(cmd) + ("   <<stdin>>" if input_text else "") + "\n")
        return subprocess.CompletedProcess(cmd, 0, "", "")
    proc = subprocess.run(
        cmd, input=input_text, capture_output=True, text=True, timeout=timeout,
        env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"},
    )
    if check and proc.returncode != 0:
        raise ProvisionError(
            f"{os.path.basename(cmd[0])} 실패 (rc={proc.returncode}): "
            f"{(proc.stderr or proc.stdout).strip()}"
        )
    return proc


# ---------------------------------------------------------------------------
# 검증
# ---------------------------------------------------------------------------
def validate_username(username):
    if not isinstance(username, str) or not USERNAME_RE.fullmatch(username):
        raise ProvisionError(f"잘못된 username: {username!r}")
    if username.lower() in RESERVED:
        raise ProvisionError(f"예약된 username: {username}")
    return username


def validate_password(password):
    if not isinstance(password, str) or not (8 <= len(password) <= 128):
        raise ProvisionError("비밀번호는 8~128자여야 합니다")
    if any(ord(c) < 32 or ord(c) == 127 for c in password):
        raise ProvisionError("비밀번호에 제어문자를 쓸 수 없습니다")
    return password


def validate_port(value, port_range, name):
    if not isinstance(value, int) or isinstance(value, bool):
        raise ProvisionError(f"{name} 는 정수여야 합니다")
    lo, hi = port_range
    if not (lo <= value <= hi):
        raise ProvisionError(f"{name} {value} 가 허용 범위 {lo}-{hi} 밖입니다")
    return value


def validate_components(components):
    if not isinstance(components, list) or not components:
        raise ProvisionError("components 목록이 필요합니다")
    bad = [c for c in components if c not in ALL_COMPONENTS]
    if bad:
        raise ProvisionError(f"알 수 없는 component: {bad}")
    return [c for c in ALL_COMPONENTS if c in components]


def get_pw(username):
    if DRY_RUN:
        return None
    try:
        return pwd.getpwnam(username)
    except KeyError:
        return None


def in_student_group(cfg, username):
    if DRY_RUN:
        return True
    try:
        g = grp.getgrnam(cfg["student_group"])
    except KeyError:
        return False
    pw = get_pw(username)
    return username in g.gr_mem or (pw is not None and pw.pw_gid == g.gr_gid)


def assert_managed(cfg, username, allow_missing=False):
    """포털이 관리하는 학생 계정인지 확인 (교수/관리자 계정 보호)."""
    pw = get_pw(username)
    if pw is None:
        if DRY_RUN or allow_missing:
            return None
        raise ProvisionError(f"Linux 사용자가 없습니다: {username}")
    if pw.pw_uid < cfg["min_uid"]:
        raise ProvisionError(f"시스템 계정은 관리할 수 없습니다: {username}")
    if not in_student_group(cfg, username):
        raise ProvisionError(
            f"{username} 은(는) '{cfg['student_group']}' 그룹이 아니므로 관리할 수 없습니다"
        )
    return pw


# ---------------------------------------------------------------------------
# 파일 유틸
# ---------------------------------------------------------------------------
def write_file(path, content, mode=0o644, owner=None, backup=False):
    real = P(path)
    os.makedirs(os.path.dirname(real), exist_ok=True)
    if backup and os.path.isfile(real):
        with open(real, encoding="utf-8") as f:
            if f.read() == content:
                chown(path, owner)
                return False
        shutil.copy2(real, real + ".bak")
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".bh-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(content)
    os.chmod(tmp, mode)
    os.replace(tmp, real)
    chown(path, owner)
    return True


def chown(path, owner, recursive=False):
    if owner is None or DRY_RUN:
        return
    uid, gid = owner
    real = P(path)
    os.lchown(real, uid, gid)
    if recursive:
        for root, dirs, files in os.walk(real):
            for n in dirs + files:
                os.lchown(os.path.join(root, n), uid, gid)


def mkdir(path, owner=None, mode=0o755):
    real = P(path)
    if os.path.islink(real):
        raise ProvisionError(f"심볼릭 링크는 허용되지 않습니다: {path}")
    os.makedirs(real, mode=mode, exist_ok=True)
    chown(path, owner)


def remove_file(path):
    real = P(path)
    if os.path.lexists(real):
        os.remove(real)
        return True
    return False


def safe_rmtree(base, username):
    """/srv/<svc>/<username> 만 지운다. 심볼릭 링크나 base 밖 경로는 거부."""
    target = os.path.join(P(base), username)
    if not os.path.lexists(target):
        return False
    if os.path.islink(target):
        raise ProvisionError(f"심볼릭 링크라 삭제하지 않습니다: {target}")
    if os.path.dirname(os.path.realpath(target)) != os.path.realpath(P(base)):
        raise ProvisionError(f"경로 검증 실패: {target}")
    shutil.rmtree(target)
    return True


