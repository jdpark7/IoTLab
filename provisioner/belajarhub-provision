def nginx_conf(cfg, u, node_port, spring_port, components):
    srv = cfg["srv_base"]
    parts = [f"""# Managed by belajarhub-provision — 수동 수정 시 덮어써집니다.
server {{
    listen 80;
    server_name {u}.{cfg['domain']};
    return 301 https://$host$request_uri;
}}

server {{
    listen 443 ssl;
    server_name {u}.{cfg['domain']};

    ssl_certificate     {cfg['ssl_certificate']};
    ssl_certificate_key {cfg['ssl_certificate_key']};

    root {srv}/php/{u}/public;
    index index.php index.html;

    access_log /var/log/nginx/{u}_access.log;
    error_log  /var/log/nginx/{u}_error.log;

    location / {{
        index index.php index.html;
        try_files $uri $uri/ /index.php?$query_string;
    }}
"""]
    if "php" in components:
        parts.append(f"""
    location ~ \\.php$ {{
        include fastcgi_params;
        fastcgi_pass unix:{cfg['php_fpm_socket']};
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }}
""")
    if "django" in components:
        parts.append(f"""
    location /django/ {{
        proxy_redirect off;
        proxy_pass http://unix:{cfg['django_run_dir']}/{u}.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header SCRIPT_NAME /django;
        proxy_set_header Cookie $http_cookie;
    }}

    location /django/static/ {{
        alias {srv}/django/{u}/staticfiles/;
    }}
""")
    if "nodejs" in components:
        parts.append(f"""
    location /nodejs/ {{
        proxy_pass http://127.0.0.1:{node_port}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }}
""")
    if "spring" in components:
        parts.append(f"""
    location /spring/ {{
        proxy_pass http://127.0.0.1:{spring_port};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }}
""")
    parts.append("}\n")
    return "".join(parts)


def supervisor_conf(cfg, svc, u, home, node_port, spring_port):
    b = cfg["bin"]
    srv = cfg["srv_base"]
    t = f"{b['timeout']} {cfg['process_timeout']} "
    head = "; Managed by belajarhub-provision\n"
    if svc == "django":
        return head + f"""[program:django_{u}]
directory={srv}/django/{u}
command={t}{srv}/django/{u}/venv/bin/gunicorn --workers 1 --bind unix:{cfg['django_run_dir']}/{u}.sock myproject.wsgi:application
user={u}
autostart=false
autorestart=false
stopasgroup=true
killasgroup=true

stdout_logfile={srv}/django/{u}/log/{u}_stdout.log
stderr_logfile={srv}/django/{u}/log/{u}_stderr.log
redirect_stderr=false
environment=PYTHONUNBUFFERED="1"
"""
    if svc == "nodejs":
        red = f"{srv}/nodejs/{u}/.node-red"
        return head + f"""[program:nodejs_{u}]
command={t}{b['node_red']} --userDir {red} --settings {red}/settings.js
directory={srv}/nodejs/{u}
user={u}
autostart=false
autorestart=false
stopasgroup=true
killasgroup=true
stdout_logfile={srv}/nodejs/{u}/log/nodejs_stdout.log
stderr_logfile={srv}/nodejs/{u}/log/nodejs_stderr.log
environment=HOME="{home}",USER="{u}"
"""
    if svc == "spring":
        return head + f"""[program:spring_{u}]
command={t}{b['java']} -jar {cfg['spring_jar']} --server.port={spring_port}
directory={srv}/spring/{u}/{cfg['spring_workdir']}
user={u}
autostart=false
autorestart=false
startsecs=5
stopasgroup=true
killasgroup=true
stdout_logfile={srv}/spring/{u}/logs/spring.log
stderr_logfile={srv}/spring/{u}/logs/spring.err
environment=HOME="{home}",USER="{u}"
"""
    raise ProvisionError(svc)


def nodered_settings(u, node_port, bcrypt_hash, secret):
    return f"""// Managed by belajarhub-provision (비밀번호 변경 시 다시 생성됩니다)
module.exports = {{
    uiPort: {node_port},
    uiHost: "127.0.0.1",

    adminAuth: {{
        type: "credentials",
        users: [{{
            username: "{u}",
            password: "{bcrypt_hash}",
            permissions: "*"
        }}]
    }},

    httpAdminRoot: "/",
    httpNodeRoot: "/",

    ui: {{
        path: "ui"
    }},

    credentialSecret: "{secret}",

    editorTheme: {{
        projects: {{
            enabled: false
        }}
    }}
}}
"""


def control_script(cfg, op, program):
    return f"#!/bin/bash\n/usr/bin/sudo -n {cfg['bin']['supervisorctl']} {op} {program}\n"


def sudoers_content(cfg, u, services):
    lines = [f"# Managed by belajarhub-provision for {u}"]
    for svc in services:
        for op in SERVICE_OPS:
            lines.append(
                f"{u} ALL=(root) NOPASSWD: {cfg['bin']['supervisorctl']} {op} {svc}_{u}"
            )
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------------------
# 단계별 작업
# ---------------------------------------------------------------------------
def step_group(cfg, r):
    if DRY_RUN:
        run([cfg["bin"]["groupadd"], "-f", cfg["student_group"]])
    else:
        try:
            grp.getgrnam(cfg["student_group"])
        except KeyError:
            run([cfg["bin"]["groupadd"], cfg["student_group"]])
    r.step("group", True, cfg["student_group"])


def step_linux_user(cfg, r, u, password, force_change):
    b = cfg["bin"]
    pw = get_pw(u)
    created = False
    if pw is None:
        run([b["useradd"], "-m", "-s", "/bin/bash", "-G", cfg["student_group"], u])
        created = True
    else:
        if pw.pw_uid < cfg["min_uid"]:
            raise ProvisionError(f"시스템 계정은 사용할 수 없습니다: {u}")
        if not in_student_group(cfg, u):
            raise ProvisionError(
                f"이미 존재하는 계정 {u} 이(가) '{cfg['student_group']}' 그룹이 아닙니다. "
                f"기존 학생이면 'usermod -aG {cfg['student_group']} {u}' 실행 후 다시 시도하세요."
            )
    run([b["chpasswd"]], input_text=f"{u}:{password}\n")
    if created and force_change:
        run([b["chage"], "-d", "0", u])
    r.step("linux_user", True, "created" if created else "exists, password set")


def owner_of(u):
    pw = get_pw(u)
    if pw is None:
        return None
    return (pw.pw_uid, pw.pw_gid)


def home_of(cfg, u):
    pw = get_pw(u)
    return pw.pw_dir if pw else f"{cfg['home_base']}/{u}"


def step_dirs(cfg, r, u, components, node_port, spring_port):
    own = owner_of(u)
    srv = cfg["srv_base"]
    home = home_of(cfg, u)
    made = []

    for svc in SRV_DIRS:
        mkdir(f"{srv}/{svc}", owner=None)

    if "php" in components:
        mkdir(f"{srv}/php/{u}", own)
        mkdir(f"{srv}/php/{u}/public", own)
        idx = f"{srv}/php/{u}/public/index.php"
        if not os.path.exists(P(idx)):
            write_file(idx, f'<?php\necho "<h1>Welcome {u}</h1>";\necho "<p>PHP is working!</p>";\n?>\n',
                       owner=own)
        made.append("php")

    if "django" in components:
        mkdir(f"{srv}/django/{u}", own)
        mkdir(f"{srv}/django/{u}/log", own)
        made.append("django")

    if "nodejs" in components:
        for d in ("", "/.node-red", "/log", "/bin"):
            mkdir(f"{srv}/nodejs/{u}{d}", own)
        flows = f"{srv}/nodejs/{u}/.node-red/flows.json"
        if not os.path.exists(P(flows)):
            write_file(flows, "[]\n", owner=own)
        write_file(f"{home}/nodejs-port", f"{node_port}\n", owner=own)
        made.append("nodejs")

    if "spring" in components:
        for d in ("", "/bin", "/logs"):
            mkdir(f"{srv}/spring/{u}{d}", own)
        write_file(f"{srv}/spring/{u}/spring-port", f"{spring_port}\n", owner=own)
        write_file(f"{home}/spring-port", f"{spring_port}\n", owner=own)
        made.append("spring")

    # 제어 스크립트: 기존 위치 그대로 (django → ~/bin, nodejs/spring → /srv/<svc>/<u>/bin)
    script_dirs = {
        "django": f"{home}/bin",
        "nodejs": f"{srv}/nodejs/{u}/bin",
        "spring": f"{srv}/spring/{u}/bin",
    }
    for svc in SERVICES:
        if svc not in components:
            continue
        d = script_dirs[svc]
        mkdir(d, own)
        for op in SERVICE_OPS:
            write_file(f"{d}/{op}_mine.sh", control_script(cfg, op, f"{svc}_{u}"),
                       mode=0o755, owner=own)
    r.step("directories", True, ", ".join(made))


def step_nodered(cfg, r, u, password, node_port):
    srv = cfg["srv_base"]
    settings = f"{srv}/nodejs/{u}/.node-red/settings.js"
    if DRY_RUN:
        bcrypt_hash = "$2y$08$DRYRUNDRYRUNDRYRUNDRYRUNDRYRUNDRYRUNDRYRUNDRYRUNDRYRU"
    else:
        # -i: 비밀번호를 stdin 으로 받는다 (ps 에 노출되지 않음)
        out = run([cfg["bin"]["htpasswd"], "-niBC", "8", u], input_text=password).stdout
        bcrypt_hash = out.strip().split(":", 1)[1]
    # credentialSecret 은 한 번 정하면 유지 (바꾸면 저장된 credential 을 못 읽음)
    secret = f"{u}_node_red_secret_2026"
    real = P(settings)
    if os.path.isfile(real):
        m = re.search(r'credentialSecret:\s*"([^"]+)"', open(real, encoding="utf-8").read())
        if m:
            secret = m.group(1)
    else:
        secret = f"{u}_{secrets.token_hex(12)}"
    write_file(settings, nodered_settings(u, node_port, bcrypt_hash, secret),
               owner=owner_of(u), backup=True)
    r.step("nodered_settings", True, f"port {node_port}")


def step_supervisor(cfg, r, u, components, node_port, spring_port):
    home = home_of(cfg, u)
    written = []
    for svc in SERVICES:
        path = f"{cfg['supervisor_conf_dir']}/{svc}_{u}.conf"
        if svc in components:
            write_file(path, supervisor_conf(cfg, svc, u, home, node_port, spring_port),
                       backup=True)
            written.append(svc)
        else:
            remove_file(path)
    r.step("supervisor_conf", True, ", ".join(written) or "none")


def install_sudoers(cfg, path, content):
    """임시 파일로 visudo -cf 검사 후에만 설치한다."""
    real = P(path)
    os.makedirs(os.path.dirname(real), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".bh-")  # '.' 포함 파일은 sudo 가 무시
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp, 0o440)
        run([cfg["bin"]["visudo"], "-cf", tmp])
        os.replace(tmp, real)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def step_sudoers(cfg, r, u, components):
    services = [s for s in SERVICES if s in components]
    path = f"{cfg['sudoers_dir']}/belajarhub-{u}"
    if services:
        install_sudoers(cfg, path, sudoers_content(cfg, u, services))
    else:
        remove_file(path)
    r.step("sudoers", True, ", ".join(services) or "none")


def step_nginx(cfg, r, u, components, node_port, spring_port, test=True):
    path = f"{cfg['nginx_conf_dir']}/{u}.conf"
    real = P(path)
    old = open(real, encoding="utf-8").read() if os.path.isfile(real) else None
    write_file(path, nginx_conf(cfg, u, node_port, spring_port, components), backup=True)
    if test:
        try:
            run([cfg["bin"]["nginx"], "-t"])
        except ProvisionError:
            # 설정 오류 시 이전 상태로 되돌린다
            if old is None:
                remove_file(path)
            else:
                write_file(path, old)
            raise
    r.step("nginx_conf", True, f"{u}.{cfg['domain']}")


# --- MQTT ------------------------------------------------------------------
def acl_parse(text):
    """ACL 을 (머리말 줄들, [(username, [줄...]), ...]) 로 나눈다."""
    header, sections, cur = [], [], None
    for line in text.splitlines():
        m = re.match(r"^\s*user\s+(\S+)\s*$", line)
        if m:
            cur = (m.group(1), [line])
            sections.append(cur)
        elif re.match(r"^\s*pattern\s", line) and cur is not None:
            cur = None
            header.append(line)
        elif cur is None:
            header.append(line)
        else:
            cur[1].append(line)
    return header, sections


def acl_render(header, sections):
    out = "\n".join(header).rstrip() + "\n"
    for _, lines in sections:
        body = "\n".join(lines).strip()
        out += "\n" + body + "\n"
    return out


def acl_update(cfg, u, present):
    path = cfg["mosquitto_acl"]
    real = P(path)
    text = open(real, encoding="utf-8").read() if os.path.isfile(real) else \
        f"# Auto-generated student MQTT ACL\n# Topic format: {cfg['mqtt_topic_prefix']}/{{username}}/#\n"
    header, sections = acl_parse(text)
    sections = [s for s in sections if s[0] != u]
    if present:
        sections.append((u, [f"user {u}", f"topic readwrite {cfg['mqtt_topic_prefix']}/{u}/#"]))
    write_file(path, acl_render(header, sections), mode=0o644, backup=True)


def step_mqtt(cfg, r, u, password):
    b = cfg["bin"]
    passwd = cfg["mosquitto_passwd"]
    if not DRY_RUN and not os.path.isfile(passwd):
        run([b["mosquitto_passwd"], "-c", "-b", passwd, u, password])
    else:
        run([b["mosquitto_passwd"], "-b", P(passwd), u, password])
    if not DRY_RUN:
        os.chmod(passwd, 0o640)
        try:
            os.chown(passwd, -1, grp.getgrnam("mosquitto").gr_gid)
        except KeyError:
            pass
    acl_update(cfg, u, True)
    r.step("mqtt", True, f"topic {cfg['mqtt_topic_prefix']}/{u}/#")


# --- MariaDB ---------------------------------------------------------------
def sql_str(s):
    return "'" + s.replace("\\", "\\\\").replace("'", "''") + "'"


def step_mariadb(cfg, r, u, password):
    # root 는 unix_socket 인증으로 접속 (Debian/Ubuntu 기본)
    sql = f"""
CREATE DATABASE IF NOT EXISTS `{u}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS {sql_str(u)}@'localhost' IDENTIFIED BY {sql_str(password)};
ALTER USER {sql_str(u)}@'localhost' IDENTIFIED BY {sql_str(password)};
GRANT ALL PRIVILEGES ON `{u}`.* TO {sql_str(u)}@'localhost';
FLUSH PRIVILEGES;
"""
    run([cfg["bin"]["mariadb"], "-u", "root"], input_text=sql)
    r.step("mariadb", True, f"database `{u}`")


# --- reload ----------------------------------------------------------------
def do_reload(cfg, r, nginx=True, supervisor=True, mosquitto=True):
    b = cfg["bin"]
    if supervisor:
        try:
            run([b["supervisorctl"], "reread"])
            run([b["supervisorctl"], "update"])
            r.step("reload_supervisor", True)
        except ProvisionError as e:
            r.step("reload_supervisor", False, str(e))
    if nginx:
        try:
            run([b["nginx"], "-t"])
            run([b["systemctl"], "reload", "nginx"])
            r.step("reload_nginx", True)
        except ProvisionError as e:
            r.step("reload_nginx", False, str(e))
    if mosquitto:
        try:
            # passwd/acl 은 SIGHUP(reload)으로 다시 읽는다
            if run([b["systemctl"], "reload", "mosquitto"], check=False).returncode != 0:
                run([b["systemctl"], "restart", "mosquitto"])
            r.step("reload_mosquitto", True)
        except ProvisionError as e:
            r.step("reload_mosquitto", False, str(e))


