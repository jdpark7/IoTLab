# /etc/belajarhub/portal.env  (0640 root:belajarhub) — install.sh 가 처음 한 번 생성
PORTAL_SECRET_KEY=change-me
PORTAL_ALLOWED_HOSTS=portal.belajarhub.id
PORTAL_CSRF_TRUSTED_ORIGINS=https://portal.belajarhub.id
PORTAL_DB_PATH=/var/lib/belajarhub/portal.sqlite3
PORTAL_STATIC_ROOT=/opt/belajarhub-portal/staticfiles
PORTAL_TIME_ZONE=Asia/Jakarta

LAB_DOMAIN=belajarhub.id
LAB_SSH_HOST=belajarhub.id
LAB_MQTT_HOST=mqtt.belajarhub.id
LAB_MQTT_PORT=8883
LAB_MQTT_TOPIC_PREFIX=unsia
LAB_PROVISION_CMD=/usr/bin/sudo -n /usr/local/sbin/belajarhub-provision

# random(권장) 또는 기존 방식처럼 "{username}*01"
LAB_PASSWORD_MODE=random
# 첫 SSH 로그인 때 비밀번호 변경 강제 (chage -d 0)
LAB_FORCE_PASSWORD_CHANGE=false
